{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "agendahub-route": {
        "ClusterId": "agendahub-cluster",
        "Match": {
          "Path": "/api/agendahub/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/{**catch-all}" }
        ]
      }
    },
    "Clusters": {
      "agendahub-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://ms-agendahub:5001"
          }
        }
      }
    }
  }
}
